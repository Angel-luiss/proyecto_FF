@page "/productos/crear"
@rendermode InteractiveServer

@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations

<h3>Crear Producto</h3>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger">
        ❌ @mensajeError
    </div>
}

@if (mensajeExito)
{
    <div class="alert alert-success">
        ✅ Producto agregado correctamente
    </div>
}

<EditForm Model="producto" OnValidSubmit="Guardar" FormName="crearProducto">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Código</label>
        <InputText class="form-control" @bind-Value="producto.Codigo" />
    </div>

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <InputText class="form-control" @bind-Value="producto.Nombre" />
    </div>

    <div class="mb-3">
        <label class="form-label">Precio</label>
        <InputNumber class="form-control" @bind-Value="producto.Precio" />
    </div>

    <div class="mb-3">
        <label class="form-label">Stock</label>
        <InputNumber class="form-control" @bind-Value="producto.Stock" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancelar">Cancelar</button>
</EditForm>

@code {

    private Producto producto = new();
    private bool mensajeExito = false;
    private string? mensajeError;

    private async Task Guardar()
    {
        mensajeError = null;
        mensajeExito = false;

        var client = ClientFactory.CreateClient("Api");
        var response = await client.PostAsJsonAsync("api/productos", producto);

        if (response.IsSuccessStatusCode)
        {
            mensajeExito = true;
            StateHasChanged();

            await Task.Delay(1500);
            Nav.NavigateTo("/productos", true);
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();

            // Si backend devuelve texto plano
            mensajeError = error;

            // Si devuelve JSON tipo { message: "..." }
            // Puedes mejorar luego deserializando

            StateHasChanged();
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/productos");
    }

    public class Producto
    {
        [Required(ErrorMessage = "El código es obligatorio")]
        public string Codigo { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre es obligatorio")]
        public string Nombre { get; set; } = string.Empty;

        [Range(0.01, double.MaxValue, ErrorMessage = "El precio debe ser mayor que 0")]
        public decimal Precio { get; set; }

        [Range(0, int.MaxValue, ErrorMessage = "El stock no puede ser negativo")]
        public int Stock { get; set; }
    }
}